#cloud-config
# AlmaLinux 10 + Docker CE + Minikube（docker 驱动，无需嵌套虚拟化）
ssh_pwauth: true
users:
  - name: cliff
    groups: sudo
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
chpasswd:
  list: |
    root:sec202609
    cliff:sec202609
  expire: false
disable_root: false
package_update: true
packages:
  - bash-completion
  - vim
  - curl
  - tar
write_files:
  # 重启后以 cliff 身份拉起 / 停止 minikube 集群
  - path: /etc/systemd/system/minikube.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Minikube
      Requires=docker.service
      After=docker.service network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      User=cliff
      Group=cliff
      Environment=HOME=/home/cliff
      TimeoutStartSec=900
      ExecStart=/usr/local/bin/minikube start
      ExecStop=/usr/local/bin/minikube stop

      [Install]
      WantedBy=multi-user.target

  - path: /etc/docker/daemon.json
    permissions: '0644'
    content: |
      {
          "registry-mirrors": [
              "https://docker.m.daocloud.io",
              "https://hub.rat.dev"
          ]
      }
      
runcmd:
  - [growpart, /dev/vda, 4]
  - [xfs_growfs, /]
  # 安装内核模块 for docker
  - dnf install -y kernel-modules-extra-$(uname -r)
  # 安装 Docker
  - [  dnf, install, -y, dnf-plugins-core  ]
  # 添加 Docker CE 仓库（网络失败自动重试：最多 100 次，间隔 5 秒）
  - |
    n=0
    until dnf config-manager -y --add-repo https://download.docker.com/linux/rhel/docker-ce.repo || [ -s /etc/yum.repos.d/docker-ce.repo ]; do
      n=$((n+1))
      if [ "$n" -ge 100 ]; then
        echo "添加 docker-ce.repo 失败，已重试 $n 次" >&2
        exit 1
      fi
      sleep 5
    done
  # 安装 Docker CE 组件（网络失败自动重试：最多 100 次，间隔 5 秒）
  - |
    n=0
    until dnf install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin; do
      n=$((n+1))
      if [ "$n" -ge 100 ]; then
        echo "安装 Docker CE 失败，已重试 $n 次" >&2
        exit 1
      fi
      sleep 5
    done
  - [ systemctl, enable, --now, docker ]
  - [ /usr/sbin/usermod, -aG, docker, cliff ]
  # 安装 Minikube
  - [
      curl, -fLO,
      --retry, 100, --retry-all-errors,
      --retry-delay, 5, --retry-max-time, 600,
      --connect-timeout, 60,
      https://github.com/kubernetes/minikube/releases/latest/download/minikube-linux-amd64 
    ]
  - [ install, minikube-linux-amd64, /usr/local/bin/minikube ]
  - [ rm, minikube-linux-amd64 ]
  # 安装 kubectl 二进制文件
  - |
    kubectl_version=$(curl --retry 100 --retry-all-errors --retry-delay 5 \
      --retry-max-time 600 --connect-timeout 60 -L -s \
      https://dl.k8s.io/release/stable.txt)
    curl --retry 100 --retry-all-errors --retry-delay 5 \
      --retry-max-time 600 --connect-timeout 60 \
      -LO "https://dl.k8s.io/release/${kubectl_version}/bin/linux/amd64/kubectl"
  - [ install, -o, root, -g, root, -m, "0755", kubectl, /usr/local/bin/kubectl ]
  - [ rm, kubectl ]
  - minikube completion bash > /etc/bash_completion.d/minikube.sh
  - kubectl completion bash > /etc/bash_completion.d/kubectl.sh
  - [ systemctl, enable, minikube.service ]
