#cloud-config
# AlmaLinux 10 + Docker CE + Minikube（docker 驱动，无需嵌套虚拟化）
ssh_pwauth: true
users:
  - name: cliff
    groups: sudo
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
chpasswd:
  list: |
    root:sec202609
    cliff:sec202609
  expire: false
disable_root: false
package_update: true
packages:
  - bash-completion
  - vim
  - curl
  - tar
write_files:
  # 重启后以 cliff 身份拉起 / 停止 minikube 集群
  - path: /etc/systemd/system/minikube.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Minikube
      Requires=docker.service
      After=docker.service network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      User=cliff
      Group=cliff
      Environment=HOME=/home/cliff
      TimeoutStartSec=900
      ExecStart=/usr/local/bin/minikube start
      ExecStop=/usr/local/bin/minikube stop

      [Install]
      WantedBy=multi-user.target
runcmd:
  - [growpart, /dev/vda, 4]
  - [xfs_growfs, /]
  # 安装内核模块 for docker
  - dnf install -y kernel-modules-extra-$(uname -r)
  # 安装 Docker
  - [  dnf, install, -y, dnf-plugins-core  ]
  - [ sudo, dnf, config-manager, -y, --add-repo, https://download.docker.com/linux/rhel/docker-ce.repo ]
  - [ sudo, dnf, install, -y, docker-ce, docker-ce-cli, containerd.io, docker-buildx-plugin, docker-compose-plugin ]
  - [ sudo, systemctl, enable, --now, docker ]
  - [ /usr/sbin/usermod, -aG, docker, cliff ]
  # 安装 Minikube
  - [
      curl, -fLO,
      --retry, 100, --retry-all-errors,
      --retry-delay, 5, --retry-max-time, 600,
      --connect-timeout, 60,
      https://github.com/kubernetes/minikube/releases/latest/download/minikube-linux-amd64 
    ]
  - [ install, minikube-linux-amd64, /usr/local/bin/minikube ]
  - [ rm, minikube-linux-amd64 ]
  # 安装 kubectl 二进制文件
  - >
    export KUBECTL_VERSION=$(curl --retry 100 --retry-all-errors
    --retry-delay 5 --retry-max-time 600 --connect-timeout 60
    -L -s https://dl.k8s.io/release/stable.txt)
  - [
      curl, -LO, --retry, 100, --retry-all-errors, 
      --retry-delay, 5, --retry-max-time, 600, --connect-timeout, 60, 
      "https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/amd64/kubectl" 
    ]
  - [ export, KUBECTL_VERSION= ]
  - [ install, -o, root, -g, root, -m, "0755", kubectl, /usr/local/bin/kubectl ]
